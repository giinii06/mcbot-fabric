# Oracle ARM64 2 OCPU / 12GB, Java-only survival. No secrets in this file.
# Official Paper STABLE build verified 2026-10-19; updates are manual.
MC_VERSION=26.3
PAPER_BUILD=205
PAPER_JAR_URL=https://fill-data.papermc.io/v1/objects/a0a58f532f08054ea92eb916d3edb6ed3c86429d77175317304f6e995cce9968/paper-26.3-205.jar
PAPER_SHA256=a0a58f532f08054ea92eb916d3edb6ed3c86429d77175317304f6e995cce9968

# Optional pre-generation tool, officially marked compatible with Paper 26.3.
CHUNKY_URL=https://cdn.modrinth.com/data/fALzjamp/versions/MdY6JATr/Chunky-Bukkit-1.5.3.jar
CHUNKY_SHA256=530d2c7430a96a39957391b7088be144daa3108f7665896d1c23aa8dd4af32f3

JVM_INIT_MEMORY=2G
JVM_MAX_MEMORY=6G
MAX_PLAYERS=10
VIEW_DISTANCE=6
SIMULATION_DISTANCE=4
MC_UID=1001
MC_GID=1001
TZ=Asia/Seoul
JAVA_PORT=25565

# First backup after boot, then every 24 hours; keep at least 7 days.
BACKUP_INTERVAL=24h
BACKUP_RETENTION_DAYS=7
BACKUP_COMPRESS_ARGS="-3 -T1"
BACKUP_EXCLUDES="*.jar,cache,.cache,logs,*.tmp,versions,libraries,*.rcon-cli.yaml,*.rcon-cli.env"
