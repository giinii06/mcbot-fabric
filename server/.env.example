# First backup after boot, then every 24 hours; keep at least 7 days.
BACKUP_INTERVAL=24h
BACKUP_RETENTION_DAYS=7
BACKUP_COMPRESS_ARGS="-3 -T1"
BACKUP_EXCLUDES="*.jar,cache,.cache,logs,*.tmp,versions,libraries,*.rcon-cli.yaml,*.rcon-cli.env"
