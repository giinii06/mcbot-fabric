# Oracle ARM64 2 OCPU / 12GB. Fabric 1.21.1 + Cobblemon 1.8.4, Java only.
# Every version below (and every mod in mods.lock.json) is pinned. No `latest`.
# Official sources: meta.fabricmc.net, Modrinth version PdOzYHKU / 5SwzqWUu.
MC_VERSION=1.21.1
FABRIC_LOADER_VERSION=0.20.1
FABRIC_INSTALLER_VERSION=1.1.2

# Difficulty is applied through server.properties; default is peaceful.
DIFFICULTY=peaceful

JVM_INIT_MEMORY=2G
JVM_MAX_MEMORY=6G
MAX_PLAYERS=1000
VIEW_DISTANCE=6
SIMULATION_DISTANCE=4
MC_UID=1001
MC_GID=1001
TZ=Asia/Seoul
JAVA_PORT=25565

# First backup after boot, then every 24 hours; keep at least 7 days.
BACKUP_INTERVAL=24h
BACKUP_RETENTION_DAYS=7
BACKUP_COMPRESS_ARGS="-3 -T1"
# Mod jars are re-installable from mods.lock.json; worlds, Cobblemon player
# data and configs are always included.
BACKUP_EXCLUDES="*.jar,logs,crash-reports,cache,.cache,*.tmp,libraries,versions,*.rcon-cli.yaml,*.rcon-cli.env"
