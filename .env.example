# ---------------------------------------------------------------------------
# Discord Bot (new Discord application - create it manually, do not reuse
# the token of any existing bot)
# ---------------------------------------------------------------------------
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=

# Slash commands are registered globally (전역) - no guild id needed.
# ---------------------------------------------------------------------------
# Minecraft bridge
# ---------------------------------------------------------------------------
# Shared secret. Generate with:  openssl rand -base64 48
# Must be identical in this bot (.env) and in the Minecraft plugin config
# (server/data/plugins/MinecraftBridge/config.yml). Never commit either value.
# Example: openssl rand -base64 48  -> paste into .env only, never here.
MC_BRIDGE_SECRET=

# Bot -> Minecraft plugin (private Docker network, never published)
MC_BRIDGE_BASE_URL=http://minecraft:8765

# Bot side HTTP endpoint the plugin calls (private Docker network)
MC_BOT_PORT=47865

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
SQLITE_PATH=data/mcbot.sqlite
LOG_LEVEL=info
# Optional: skip the Discord gateway (used by tests / offline verification)
# DISCORD_DISABLED=1

# Optional: run the bot container as your host user so ./data stays owned by you.
# Defaults to 1001:1001 when unset. Check with:  id -u ; id -g
# MCBOT_UID=1001
# MCBOT_GID=1001
