{
  "name": "mcbot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Minecraft server Discord integration bot (Java + Bedrock whitelist, playtime, log channel)",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "register": "bun src/scripts/register-commands.ts",
    "minecraft:commands": "bun src/scripts/register-commands.ts",
    "minecraft:build-plugin": "bash minecraft-bridge/build.sh",
    "minecraft:test": "bash minecraft-bridge/test.sh",
    "invite": "bun src/scripts/invite-url.ts"
  },
  "dependencies": {
    "discord.js": "^14.25.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.7.3"
  }
}
